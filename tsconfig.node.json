{
  // Everything that runs in Node: config files, Playwright specs, the Vite
  // plugin that builds the sign data, scripts run with tsx, and the test
  // helpers the scripts share with Vitest.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "e2e",
    "scripts",
    "src/core",
    "src/lib",
    "src/virtual.d.ts",
    "test/synthetic",
    "test/signDatabase.ts",
    "test/bench"
  ]
}
