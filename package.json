{
  "name": "wedges",
  "private": true,
  "version": "0.0.0",
  "description": "Find cuneiform signs by drawing them, or look them up in the Oracc Sign List",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bench:accuracy": "tsx --tsconfig tsconfig.node.json scripts/benchAccuracy.ts",
    "bench:performance": "tsx --tsconfig tsconfig.node.json scripts/benchPerformance.ts",
    "osl-summary": "tsx --tsconfig tsconfig.node.json scripts/osl-summary.ts",
    "build-usage": "tsx --tsconfig tsconfig.node.json scripts/usage/buildUsage.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1",
    "munkres": "^2.1.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@napi-rs/canvas": "^1.2.0",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "opentype.js": "^2.0.0",
    "playwright-core": "1.65.1",
    "prettier": "^3.10.1",
    "stream-json": "^3.9.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
