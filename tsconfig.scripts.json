{
  // Node scripts run with tsx, and the test helpers they share with Vitest.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "scripts",
    "src/core",
    "test/synthetic",
    "test/skeletonSigns.ts",
    "test/bench"
  ]
}
