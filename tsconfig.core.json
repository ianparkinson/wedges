{
  // src/core is plain TypeScript: no React, no DOM. Leaving "DOM" out of lib
  // makes any use of window, document or canvas a type error here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/core"]
}
